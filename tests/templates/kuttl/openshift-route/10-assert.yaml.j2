{% if test_scenario['values']['openshift'] == 'true' %}
---
apiVersion: v1
kind: Service
metadata:
  name: listener
spec:
  type: ClusterIP
---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: listener
spec:
  to:
    kind: Service
    name: listener
  port:
    targetPort: https
  tls:
    termination: passthrough
---
apiVersion: listeners.stackable.tech/v1alpha1
kind: Listener
metadata:
  name: listener
status:
  ingressAddresses:
    - addressType: Hostname
      ports:
        https: 443
{% endif %}
